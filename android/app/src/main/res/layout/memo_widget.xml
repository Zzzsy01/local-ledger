<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/widget_title" android:textColor="#34352E" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_add" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_add" android:contentDescription="@string/widget_new_task" android:textColor="#34352E" android:textSize="28sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#34352E" android:textSize="15sp" />
    <TextView android:id="@+id/widget_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#34352E" android:textSize="15sp" />
    <TextView android:id="@+id/widget_row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#34352E" android:textSize="15sp" />
</LinearLayout>
